---
import { render } from "astro:content";
import BaseLayout from "../../components/layout/BaseLayout.astro";
import ContentArticle from "../../components/page/ContentArticle.astro";
import Author from "../../components/ui/Author.astro";
import { formatDate, getPosts, isoDate, readingTime } from "../../lib/content";

export async function getStaticPaths() {
    const posts = await getPosts();
    return posts.map((post, i) => ({
        params: { slug: post.id },
        props: { post, newer: posts[i - 1], older: posts[i + 1] },
    }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const link = (p?: typeof post) => (p ? { label: p.data.title, href: `/blog/${p.id}/` } : undefined);
---

<BaseLayout title={post.data.title} description={post.data.description}>
    <ContentArticle
        crumbs={[{ label: "Blog", href: "/blog/" }, { label: post.data.title }]}
        title={post.data.title}
        lead={post.data.description}
        prev={link(older)}
        next={link(newer)}
        prevText="← Older"
        nextText="Newer →"
        back={{ label: "All posts", href: "/blog/" }}
        headings={headings.filter((h) => h.depth === 2 || h.depth === 3)}
    >
        <div slot="meta" class="grid gap-3 font-mono text-sm">
            <p class="flex justify-center text-fg-soft hover:[&>a]:text-fg">
                <Author name={post.data.author} github={post.data.github} />
            </p>
            <p class="flex items-center justify-center gap-x-3 text-fg-muted">
                <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
                <span aria-hidden="true" class="text-fg-faint">·</span>
                <span>{readingTime(post.body)}</span>
            </p>
        </div>

        <Content />
    </ContentArticle>
</BaseLayout>
