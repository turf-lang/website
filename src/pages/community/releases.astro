---
import CommunityTabs from "../../components/community/CommunityTabs.astro";
import FetchNotice from "../../components/community/FetchNotice.astro";
import BaseLayout from "../../components/layout/BaseLayout.astro";
import PageHeader from "../../components/page/PageHeader.astro";
import BoxGrid from "../../components/ui/BoxGrid.astro";
import { githubOrg, releaseRepo } from "../../data/community";
import { boxGridSpan } from "../../lib/box-grid";
import { formatDate, isoDate } from "../../lib/content";
import { getReleaseEntries } from "../../lib/releases";
import { renderEntryText } from "../../lib/release-text";

const href = "/community/releases/";
const lead = "Every version of Turf, newest first. Open a release for the full story, in our own words, and the complete changelog.";
const { entries, latest, upcoming, ok } = await getReleaseEntries();
const older = entries.filter((entry) => entry.released && entry !== latest);
const highlights = latest?.notes?.data.highlights ?? [];
---

<BaseLayout title="Release notes · Open Source" description={lead}>
    <PageHeader
        crumbs={[{ label: "Open Source", href: "/community/" }, { label: "Release notes" }]}
        title="Release notes"
        lead={lead}
        meta={latest ? [`${entries.length - upcoming.length} releases`, `Latest ${latest.tag}`] : undefined}
    />
    <CommunityTabs current={href} />

    <main class="container-page py-12 md:py-16">
        {
            !ok || !latest ? (
                <FetchNotice href={`https://github.com/${githubOrg}/${releaseRepo}/releases`} what="release notes" />
            ) : (
                <>
                    {upcoming.map((release) => (
                        <a
                            href={release.href}
                            class="group mb-6 flex flex-wrap items-center justify-between gap-x-8 gap-y-3 rounded-2xl border border-dashed border-line-strong px-8 py-6 transition-colors hover:border-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                        >
                            <span class="flex flex-wrap items-center gap-x-5 gap-y-1">
                                <span class="font-mono text-sm text-accent">Coming next</span>
                                <span class="font-pixel text-3xl leading-none tracking-[-0.04em] text-fg">{release.tag}</span>
                                <span class="text-fg-muted">{release.title}</span>
                            </span>
                            <span class="font-mono text-sm text-fg-muted transition-colors group-hover:text-fg">
                                Read the preview →
                            </span>
                        </a>
                    ))}
                    <a
                        href={latest.href}
                        class="group block overflow-hidden rounded-2xl border border-line bg-surface-raised p-8 transition-colors hover:border-line-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent md:p-12"
                    >
                        <div class="grid gap-10 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-16">
                            <div>
                                <p class="font-mono text-sm text-accent">Latest release</p>
                                <p class="mt-6 font-pixel text-6xl leading-none tracking-[-0.05em] text-fg md:text-7xl">{latest.tag}</p>
                                <time datetime={isoDate(latest.date)} class="mt-6 block font-mono text-sm text-fg-muted">
                                    {formatDate(latest.date)}
                                </time>
                            </div>
                            <div class="min-w-0">
                                <h2 class="text-balance font-pixel text-3xl leading-[1.05] tracking-[-0.04em] text-fg md:text-4xl">
                                    {latest.title}
                                </h2>
                                <p class="mt-4 max-w-2xl leading-7 text-fg-muted">{latest.summary}</p>
                                {highlights.length > 0 && (
                                    <ul class="mt-8 grid gap-3 border-t border-line pt-8">
                                        {highlights.map((item) => (
                                            <li class="flex gap-3 leading-7 text-fg-soft">
                                                <span aria-hidden="true" class="mt-3 size-1.5 shrink-0 rounded-full bg-accent" />
                                                <span set:html={renderEntryText(item)} />
                                            </li>
                                        ))}
                                    </ul>
                                )}
                                <span class="mt-10 inline-flex items-center gap-2 font-mono text-sm text-accent transition-colors group-hover:text-fg">
                                    Read the release notes
                                    <span aria-hidden="true" class="transition-transform group-hover:translate-x-1 motion-reduce:transition-none">→</span>
                                </span>
                            </div>
                        </div>
                    </a>

                    {older.length > 0 && (
                        <div class="mt-12">
                            <BoxGrid>
                                {older.map((release, i) => (
                                    <li class:list={["bg-surface", boxGridSpan(i, older.length)]}>
                                        <a
                                            href={release.href}
                                            class="group flex h-full flex-col p-8 transition-colors hover:bg-surface-raised focus-visible:-outline-offset-2 focus-visible:outline-2 focus-visible:outline-accent md:p-10"
                                        >
                                            <span class="flex items-center justify-between font-mono text-sm text-fg-muted">
                                                <time datetime={isoDate(release.date)}>{formatDate(release.date)}</time>
                                                {release.prerelease && <span class="rounded-full border border-line px-2.5 py-0.5 text-xs">Pre-release</span>}
                                            </span>
                                            <span class="mt-8 font-pixel text-5xl leading-none tracking-[-0.04em] text-fg">{release.tag}</span>
                                            <h3 class="mt-4 text-balance text-lg font-bold tracking-[-0.02em] text-fg">{release.title}</h3>
                                            {release.summary && <p class="mt-3 leading-7 text-fg-muted">{release.summary}</p>}
                                            <span class="mt-auto flex items-center gap-2 pt-8 font-mono text-sm text-fg-muted transition-colors group-hover:text-fg">
                                                Read more
                                                <span aria-hidden="true" class="transition-transform group-hover:translate-x-1 motion-reduce:transition-none">→</span>
                                            </span>
                                        </a>
                                    </li>
                                ))}
                            </BoxGrid>
                        </div>
                    )}
                </>
            )
        }
    </main>
</BaseLayout>
