---
import ContributorBoard from "../../components/community/ContributorBoard.astro";
import CommunityTabs from "../../components/community/CommunityTabs.astro";
import FetchNotice from "../../components/community/FetchNotice.astro";
import BaseLayout from "../../components/layout/BaseLayout.astro";
import PageHeader from "../../components/page/PageHeader.astro";
import { githubOrg } from "../../data/community";
import { getContributors, getWeeklyContributors } from "../../lib/github";

const href = "/community/contributors/";
const lead = "The people who write Turf, ranked by commits across the compiler, command line, language server, fuzzer and website. This week, and of all time.";
const [weekly, allTime] = await Promise.all([getWeeklyContributors(), getContributors()]);
const totalCommits = allTime.data.reduce((sum, c) => sum + c.commits, 0);
const ranges = [
    {
        id: "weekly",
        label: "This week",
        note: "Commits from the last seven days.",
        result: weekly,
        what: "this week's contributors",
        empty: "No commits in the last seven days. Open a pull request and your name lands here.",
    },
    {
        id: "all-time",
        label: "All time",
        note: "Every commit since the first one.",
        result: allTime,
        what: "contributors",
        empty: "No contributors yet. Be the first. Open a pull request and your name lands here.",
    },
];
const orgUrl = `https://github.com/${githubOrg}`;
---

<BaseLayout title="Top contributors · Open Source" description={lead}>
    <PageHeader
        crumbs={[{ label: "Open Source", href: "/community/" }, { label: "Top contributors" }]}
        title="Top contributors"
        lead={lead}
        meta={allTime.ok ? [`${allTime.data.length} contributors`, `${totalCommits.toLocaleString("en-US")} commits`] : undefined}
    />
    <CommunityTabs current={href} />

    <main class="container-page py-12 md:py-16">
        <div role="tablist" aria-label="Time range" class="inline-flex rounded-full border border-line bg-tint p-1 font-mono text-sm">
            {
                ranges.map((range, i) => (
                    <button
                        type="button"
                        role="tab"
                        id={`tab-${range.id}`}
                        aria-controls={`panel-${range.id}`}
                        aria-selected={i === 0 ? "true" : "false"}
                        tabindex={i === 0 ? 0 : -1}
                        data-range-tab
                        class="rounded-full px-5 py-2 text-fg-muted transition-colors hover:text-fg focus-visible:outline-2 focus-visible:outline-accent aria-selected:bg-accent-soft aria-selected:text-fg"
                    >
                        {range.label}
                    </button>
                ))
            }
        </div>

        {
            ranges.map((range, i) => (
                <section
                    role="tabpanel"
                    id={`panel-${range.id}`}
                    aria-labelledby={`tab-${range.id}`}
                    hidden={i !== 0}
                    class="mt-8"
                >
                    <p class="mb-8 max-w-xl leading-7 text-fg-muted">{range.note}</p>
                    {range.result.ok ? (
                        <ContributorBoard people={range.result.data} empty={range.empty} />
                    ) : (
                        <FetchNotice href={orgUrl} what={range.what} />
                    )}
                </section>
            ))
        }

        <script>
            const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-range-tab]")];
            const select = (tab: HTMLButtonElement) => {
                for (const t of tabs) {
                    const on = t === tab;
                    t.setAttribute("aria-selected", String(on));
                    t.tabIndex = on ? 0 : -1;
                    document.getElementById(t.getAttribute("aria-controls")!)!.hidden = !on;
                }
                tab.focus();
            };
            tabs.forEach((tab, i) => {
                tab.addEventListener("click", () => select(tab));
                tab.addEventListener("keydown", (e) => {
                    if (e.key === "ArrowRight") select(tabs[(i + 1) % tabs.length]);
                    if (e.key === "ArrowLeft") select(tabs[(i - 1 + tabs.length) % tabs.length]);
                });
            });
        </script>

        {
            (weekly.ok || allTime.ok) && (
                <p class="mt-12 max-w-xl leading-7 text-fg-muted md:mt-16">
                    Commit counts come from GitHub and refresh each time the site is built. Bots are left out.
                </p>
            )
        }
    </main>
</BaseLayout>
