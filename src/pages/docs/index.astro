---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import PageHeader from "../../components/page/PageHeader.astro";
import Section from "../../components/sections/Section.astro";
import { DOCS_START_HERE, DOCS_VERSION, getDocAreas, getFlatDocs } from "../../lib/docs";

const lead = "Guides, reference and internals for the language, the compiler and the command line.";
const [areas, flat] = await Promise.all([getDocAreas(), getFlatDocs()]);
const startHere = DOCS_START_HERE.map((slug) => flat.find((d) => d.slug === slug)).filter((d) => d !== undefined);
---

<BaseLayout title="Docs" description={lead}>
    <PageHeader crumbs={[{ label: "Docs" }]} title="Documentation" lead={lead} meta={[DOCS_VERSION]} />

    {
        startHere.length > 0 && (
            <section class="border-b border-line" aria-label="Start here">
                <div class="container-page py-12 md:py-16">
                    <h2 class="font-mono text-xs text-fg-faint">Start here</h2>
                    <ul class="mt-6 grid gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-3">
                        {startHere.map((doc) => (
                            <li class="bg-surface">
                                <a
                                    href={doc.href}
                                    class="group flex h-full flex-col p-8 transition-colors hover:bg-surface-raised focus-visible:-outline-offset-2 focus-visible:outline-2 focus-visible:outline-accent"
                                >
                                    <span class="flex items-start justify-between gap-6">
                                        <span class="text-xl font-black tracking-[-0.03em] text-fg">{doc.title}</span>
                                        <span aria-hidden="true" class="font-mono text-fg-muted transition-transform group-hover:translate-x-1 group-hover:text-fg motion-reduce:transition-none">→</span>
                                    </span>
                                    <span class="mt-3 leading-7 text-fg-muted">{doc.entry.data.description}</span>
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            </section>
        )
    }

    <Section id="areas" index="01" title="Browse by area" description="Everything in the documentation, grouped by topic." layout="stacked" class="border-t-0! py-16! md:py-20!">
        <ul class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-2">
            {
                areas.map(({ group, pages }) => (
                    <li class="bg-surface p-8 md:p-10">
                        <a
                            href={group.href}
                            class="group flex items-start justify-between gap-6 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
                        >
                            <span class="text-xl font-black tracking-[-0.03em] text-fg">{group.title}</span>
                            <span aria-hidden="true" class="font-mono text-fg-muted transition-transform group-hover:translate-x-1 group-hover:text-fg motion-reduce:transition-none">→</span>
                        </a>
                        {group.description && <p class="mt-3 leading-7 text-fg-muted">{group.description}</p>}
                        <ul class="mt-6 border-t border-line pt-4">
                            {pages.slice(0, 4).map((page) => (
                                <li>
                                    <a
                                        href={page.href}
                                        class="block py-1.5 font-mono text-sm text-fg-muted transition-colors hover:text-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                                    >
                                        {page.title}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </li>
                ))
            }
        </ul>
    </Section>
</BaseLayout>
