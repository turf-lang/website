---
import { render } from "astro:content";
import BaseLayout from "../../components/layout/BaseLayout.astro";
import ContentArticle from "../../components/page/ContentArticle.astro";
import { formatDate, formatTdpNumber, getProposals, isoDate, tdpSlug, tdpStatusHref, tdpStatusInfo } from "../../lib/content";

export async function getStaticPaths() {
    const proposals = await getProposals();
    return proposals.map((proposal, i) => ({
        params: { number: tdpSlug(proposal.data) },
        props: { proposal, prev: proposals[i - 1], next: proposals[i + 1] },
    }));
}

const { proposal, prev, next } = Astro.props;
const { data } = proposal;
const { Content } = await render(proposal);
const number = formatTdpNumber(data);
const link = (p?: typeof proposal) =>
    p ? { label: `${formatTdpNumber(p.data)} ${p.data.title}`, href: `/tdp/${tdpSlug(p.data)}/` } : undefined;

const statusList = { label: tdpStatusInfo[data.status].label, href: tdpStatusHref(data.status) };

const statusTone =
    data.status === "accepted" || data.status === "implemented"
        ? { text: "text-accent", dot: "bg-accent" }
        : data.status === "rejected" || data.status === "withdrawn"
          ? { text: "text-fg-faint", dot: "bg-fg-faint" }
          : { text: "text-fg-soft", dot: "bg-fg-muted" };

const dates = [
    { label: "Created", value: formatDate(data.date), iso: isoDate(data.date) },
    ...(data.updated ? [{ label: "Updated", value: formatDate(data.updated), iso: isoDate(data.updated) }] : []),
];

const cell = "flex grow basis-36 flex-col gap-2 bg-surface px-5 py-4 text-left";
const label = "text-xs text-fg-faint";
---

<BaseLayout title={`${number} ${data.title}`} description={data.description}>
    <ContentArticle
        crumbs={[{ label: "TDP", href: "/tdp/" }, { label: statusList.label, href: statusList.href }, { label: number }]}
        title={data.title}
        lead={data.description}
        prev={link(prev)}
        next={link(next)}
        back={{ label: `${statusList.label} proposals`, href: statusList.href }}
    >
        <dl slot="meta" class="mx-auto flex max-w-3xl flex-wrap gap-px overflow-hidden rounded-2xl border border-line bg-line font-mono text-sm">
            <div class={cell}>
                <dt class={label}>Proposal</dt>
                <dd class="text-fg">{number}</dd>
            </div>
            <div class={cell}>
                <dt class={label}>Status</dt>
                <dd class:list={["flex items-center gap-2", statusTone.text]}>
                    <span aria-hidden="true" class:list={["size-1.5 rounded-full", statusTone.dot]}></span>
                    {data.status}
                </dd>
            </div>
            {
                dates.map((date) => (
                    <div class={cell}>
                        <dt class={label}>{date.label}</dt>
                        <dd class="text-fg-soft"><time datetime={date.iso}>{date.value}</time></dd>
                    </div>
                ))
            }
            {
                data.discussion && (
                    <div class={cell}>
                        <dt class={label}>Discussion</dt>
                        <dd>
                            <a
                                href={data.discussion}
                                rel="noopener"
                                class="group inline-flex items-center gap-1.5 text-fg transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
                            >
                                Open thread
                                <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none">↗</span>
                            </a>
                        </dd>
                    </div>
                )
            }
            <div class:list={[cell, "basis-full"]}>
                <dt class={label}>{data.authors.length > 1 ? "Authors" : "Author"}</dt>
                <dd class="text-fg-soft">{data.authors.join(", ")}</dd>
            </div>
        </dl>

        <Content />
    </ContentArticle>
</BaseLayout>
