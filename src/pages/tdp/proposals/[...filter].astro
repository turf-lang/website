---
import TdpListPage from "../../../components/page/TdpListPage.astro";
import { getProposals, tdpStatusHref, tdpStatusInfo, tdpStatusOrder } from "../../../lib/content";

export async function getStaticPaths() {
    const paths = [];
    for (const filter of tdpStatusOrder) {
        if ((await getProposals(filter)).length > 0) {
            paths.push({ params: { filter }, props: { filter } });
        }
    }
    return paths;
}

const { filter } = Astro.props;
const page = { href: tdpStatusHref(filter), title: tdpStatusInfo[filter].label, lead: tdpStatusInfo[filter].lead };
---

<TdpListPage filter={filter} {...page} />
