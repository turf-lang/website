---
import { getEntry, render } from "astro:content";
import { learnComponents } from "../../components/learn";
import LearnGuide from "../../components/learn/LearnGuide.astro";

const entry = await getEntry("tsg", "overview");
if (!entry) throw new Error("Missing src/content/tsg/overview.mdx");
const { Content, headings } = await render(entry);
---

<LearnGuide
    sectionKey="tsg"
    menuLabel="Style guide menu"
    href="/tsg/"
    title={entry.data.title}
    description={entry.data.description}
    lead={entry.data.lead}
    outcomes={entry.data.outcomes}
    headings={headings.filter((h) => h.depth === 2 || h.depth === 3)}
>
    <Content components={learnComponents} />
</LearnGuide>
