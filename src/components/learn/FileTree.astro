---
interface Props {
    title: string;
}

const { title } = Astro.props;
---

<figure class="learn-block overflow-hidden rounded-2xl border border-line bg-surface-raised">
    <div class="flex min-h-11 items-center border-b border-line px-5 py-1.5">
        <span class="font-mono text-xs text-fg-muted">{title}</span>
    </div>
    <ul class="divide-y divide-line"><slot /></ul>
</figure>
