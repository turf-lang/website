---
import type { NavSection } from "../../data/navigation";

interface Props {
    section: NavSection;
    current: string;
}

const { section, current } = Astro.props;
---

<nav aria-label={`${section.heading} pages`}>
    <p class="font-mono text-xs text-fg-muted">{section.heading}</p>
    <ul class="mt-4 grid border-l border-line">
        {
            section.links.map((link) => (
                <li>
                    <a
                        href={link.href}
                        aria-current={link.href === current ? "page" : undefined}
                        class:list={[
                            "-ml-px block border-l py-1.5 pl-4 text-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
                            link.href === current
                                ? "border-accent text-fg"
                                : "border-transparent text-fg-muted hover:text-fg",
                        ]}
                    >
                        {link.label}
                    </a>
                </li>
            ))
        }
    </ul>
</nav>
