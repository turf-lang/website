---
interface Props {
    collapsible?: boolean;
    class?: string;
}

const { collapsible = false, class: className } = Astro.props;
---

<a
    href="/"
    aria-label="Turf home"
    class:list={[
        "inline-flex items-baseline font-mono font-bold tracking-[-0.04em] text-fg transition-colors hover:text-fg-muted focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent",
        className,
    ]}
>
    <span aria-hidden="true" class="inline-flex items-baseline">
        <span class="mr-[0.12em] text-accent">&gt;</span>t<span class:list={[collapsible && "wordmark-drop"]} style="--stagger: 60ms"><span>u</span></span>r<span class:list={[collapsible && "wordmark-drop"]}><span>f</span></span>
    </span>
</a>
