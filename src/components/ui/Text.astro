---
interface Props {
    text: string;
    as?: "p" | "span" | "h1" | "h3";
    class?: string;
    "aria-current"?: "page";
}

const { text, as: Tag = "p", class: className, ...rest } = Astro.props;
const parts = text.split("`");
---

<Tag class={className} {...rest}>
    {parts.map((part, i) => (i % 2 === 1 ? <code>{part}</code> : part))}
</Tag>
