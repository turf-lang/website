---
import { downloadHref } from "../../data/navigation";
import Button from "./Button.astro";
---

<div data-download class="contents">
    <Button href={downloadHref} data-download-link>
        <svg aria-hidden="true" viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter">
            <path d="M8 2.5v8M4.5 7 8 10.5 11.5 7M3 13.5h10"></path>
        </svg>
        <span data-download-label>Download Turf</span>
    </Button>
</div>

<script>
    import { detectPlatform, fetchLatestRelease, osLabels, pickAsset } from "../../lib/download";

    async function init() {
        const roots = document.querySelectorAll<HTMLElement>("[data-download]");
        if (!roots.length) return;

        const platform = await detectPlatform();

        for (const root of roots) {
            const link = root.querySelector<HTMLAnchorElement>("[data-download-link]")!;
            const label = root.querySelector<HTMLElement>("[data-download-label]")!;
            if (platform.os) {
                label.textContent = `Download for ${osLabels[platform.os]}`;
                link.hash = platform.os;
            }
        }

        const release = await fetchLatestRelease();
        const asset = release && pickAsset(release.assets, platform);

        document.querySelectorAll<HTMLElement>("[data-release-version]").forEach((el) => {
            if (release) {
                el.textContent = release.tag_name;
                el.hidden = false;
            }
        });

        if (asset) {
            for (const root of roots) {
                root.querySelector<HTMLAnchorElement>("[data-download-link]")!.href = asset.browser_download_url;
            }
        }
    }

    init();
</script>
