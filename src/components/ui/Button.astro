---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
    href: string;
    variant?: "primary" | "soft";
}

const { href, variant = "primary", class: className, ...rest } = Astro.props;

const base =
    "inline-flex items-center justify-center gap-2 rounded-full px-7 py-3 text-sm font-bold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent";

const variants = {
    primary: "bg-fg text-surface hover:bg-fg/90",
    soft: "border border-line bg-tint text-fg-soft hover:border-line-strong hover:bg-tint-strong hover:text-fg",
};
---

<a href={href} class:list={[base, variants[variant], className]} {...rest}>
    <slot />
</a>
