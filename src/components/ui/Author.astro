---
interface Props {
    name: string;
    github?: string;
    link?: boolean;
}

const { name, github, link = true } = Astro.props;
const Tag = github && link ? "a" : "span";
---

<Tag
    href={github && link ? `https://github.com/${github}` : undefined}
    rel={github && link ? "noopener" : undefined}
    class="inline-flex items-center gap-2.5 font-mono text-sm"
>
    {
        github && (
            <img
                src={`https://github.com/${github}.png?size=48`}
                alt=""
                width="24"
                height="24"
                loading="lazy"
                class="size-6 rounded-full border border-line bg-tint"
            />
        )
    }
    <span class="leading-none">{name}</span>
</Tag>
