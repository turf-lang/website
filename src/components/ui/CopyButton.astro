---
import checkIcon from "@phosphor-icons/core/assets/regular/check.svg?raw";
import copyIcon from "@phosphor-icons/core/assets/regular/copy.svg?raw";

interface Props {
    text: string;
    class?: string;
}

const { text, class: className } = Astro.props;
---

<button
    type="button"
    data-copy={text}
    aria-label="Copy to clipboard"
    title="Copy"
    class:list={[
        "group/copy grid size-8 shrink-0 place-items-center rounded-md text-fg-faint transition-colors hover:bg-tint-strong hover:text-fg focus-visible:outline-2 focus-visible:outline-accent",
        className,
    ]}
>
    <span class="size-4 group-data-copied/copy:hidden [&>svg]:size-full" set:html={copyIcon} />
    <span class="hidden size-4 text-accent group-data-copied/copy:block [&>svg]:size-full" set:html={checkIcon} />
</button>

<script>
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
        let timer: ReturnType<typeof setTimeout>;
        button.addEventListener("click", async () => {
            try {
                await navigator.clipboard.writeText(button.dataset.copy ?? "");
            } catch {
                return;
            }
            button.dataset.copied = "";
            button.setAttribute("aria-label", "Copied");
            clearTimeout(timer);
            timer = setTimeout(() => {
                delete button.dataset.copied;
                button.setAttribute("aria-label", "Copy to clipboard");
            }, 1500);
        });
    }
</script>
