---
import { commandGroups, diagnostic, diagnosticsNote, smartNote, toolchainIntro } from "../../data/home";
import { paintDiagnostic } from "../../lib/terminal";
import CodeWindow from "../ui/CodeWindow.astro";
import Text from "../ui/Text.astro";
import Section from "./Section.astro";
---

<Section id="toolchain" index="05" title="One command for all of it" description={toolchainIntro}>
    <div class="grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-2">
        {
            commandGroups.map((group) => (
                <div class="min-w-0 bg-surface p-8">
                    <p class="font-mono text-xs text-fg-faint">{group.label}</p>
                    <dl class="mt-5 grid grid-cols-[max-content_1fr] items-baseline gap-x-5 gap-y-3 text-sm leading-6">
                        {group.commands.map(([name, description]) => (
                            <>
                                <dt class="whitespace-nowrap font-mono text-fg">turf {name}</dt>
                                <dd class="text-fg-muted">{description}</dd>
                            </>
                        ))}
                    </dl>
                </div>
            ))
        }
    </div>

    <h3 class="mt-16 text-xl font-black tracking-[-0.03em] text-fg">Diagnostics are designed</h3>
    <Text text={diagnosticsNote} class="mt-3 max-w-2xl leading-7 text-fg-muted" />
    <CodeWindow class="mt-6" title="Terminal" html={paintDiagnostic(diagnostic)} />

    <h3 class="mt-16 text-xl font-black tracking-[-0.03em] text-fg">Optional help from a local model</h3>
    <Text text={smartNote} class="mt-3 max-w-2xl leading-7 text-fg-muted" />
</Section>
