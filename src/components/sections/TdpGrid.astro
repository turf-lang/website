---
import { formatDate, formatTdpNumber, isoDate, tdpSlug } from "../../lib/content";
import type { Proposal } from "../../lib/content";
import { boxGridSpan } from "../../lib/box-grid";
import BoxGrid from "../ui/BoxGrid.astro";
import Text from "../ui/Text.astro";

interface Props {
    proposals: Proposal[];
    empty?: string;
}

const { proposals, empty = "No proposals here yet." } = Astro.props;

const statusTone: Record<Proposal["data"]["status"], string> = {
    draft: "text-fg-muted",
    proposed: "text-fg-muted",
    accepted: "text-accent",
    implemented: "text-accent",
    rejected: "text-fg-faint",
    withdrawn: "text-fg-faint",
};
---

{
    proposals.length === 0 ? (
        <p class="rounded-2xl border border-line px-8 py-10 font-mono text-sm text-fg-muted md:px-10">{empty}</p>
    ) : (
        <BoxGrid>
            {proposals.map(({ data }, i) => (
                <li class:list={["bg-surface", boxGridSpan(i, proposals.length)]}>
                    <a
                        href={`/tdp/${tdpSlug(data)}/`}
                        class="group flex h-full flex-col p-8 transition-colors hover:bg-surface-raised focus-visible:-outline-offset-2 focus-visible:outline-2 focus-visible:outline-accent md:p-10"
                    >
                        <span class="flex items-center justify-between gap-4 font-mono text-sm">
                            <span class="text-fg-soft">{formatTdpNumber(data)}</span>
                            <span class={statusTone[data.status]}>{data.status}</span>
                        </span>
                        <Text as="h3" text={data.title} class="mt-6 text-balance text-xl font-black tracking-[-0.03em] text-fg" />
                        <Text text={data.description} class="mt-3 leading-7 text-fg-muted" />
                        <time datetime={isoDate(data.date)} class="mt-auto pt-8 font-mono text-sm text-fg-faint">
                            {formatDate(data.date)}
                        </time>
                    </a>
                </li>
            ))}
        </BoxGrid>
    )
}
