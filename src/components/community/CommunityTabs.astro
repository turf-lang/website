---
import { getSection } from "../../data/navigation";

interface Props {
    current: string;
}

const { current } = Astro.props;
const section = getSection("community");
const tabs = [{ label: "Overview", href: section.root }, ...section.links];
---

<nav aria-label="Open Source pages" class="border-b border-line">
    <div class="container-page">
        <ul class="-mb-px flex gap-8 overflow-x-auto whitespace-nowrap">
            {
                tabs.map((tab) => (
                    <li class="shrink-0">
                        <a
                            href={tab.href}
                            aria-current={tab.href === current ? "page" : undefined}
                            class:list={[
                                "flex items-center gap-2 border-b-2 py-4 font-mono text-sm transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent",
                                tab.href === current
                                    ? "border-accent text-fg"
                                    : "border-transparent text-fg-muted hover:text-fg",
                            ]}
                        >
                            {tab.label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</nav>
